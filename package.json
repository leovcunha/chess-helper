{
  "name": "chess-helper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chess Mistake Trainer — import games from Lichess & Chess.com, find your most common mistakes with Stockfish, and train them away.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-engine.mjs"
  },
  "dependencies": {
    "chess.js": "^1.3.1",
    "react": "^18.3.1",
    "react-chessboard": "^4.7.2",
    "react-dom": "^18.3.1",
    "stockfish": "^18.0.8",
    "stockfish-legacy": "npm:stockfish@10.0.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
